@mastersthesis{deb2018import,
  abbr={Master Project},
  title={Can import promotion increase export performance in times of global value chains? Firm-level evidence from Russia},
  author={Deb, Deepshikha and Handler, Nils and Peciar, Vladimír and Proka, Ksenia and Stolle, Juliane},
  school={Barcelona Graduate School of Economics},
  type={Master's Degree in Specialized Economic Analysis},
  year={2018},
  month={jun},
  abstract={This paper analyzes whether access to imported intermediate goods can raise export performance of Russian firms. We employ an instrumental variable strategy which exploits variation in firm-specific input tariffs to identify the effect of imported intermediates on firm exports during the period 2007-2013, utilizing a unique firm-level database on firm characteristics and customs declarations. Our results suggest that with the rising globalization and fragmentation of production processes, countries interested in raising exports need to think strategically of promoting imports as well. We propose and discuss several policy measures for Russia in the areas of tariff regulation, non-tariff measures, trade facilitation and trade integration.},
  pdf={https://repositori.upf.edu/server/api/core/bitstreams/b5298df9-03eb-44fd-b1d4-c28eff13adb3/content}
}