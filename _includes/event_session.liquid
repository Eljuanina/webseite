{% assign parent = site.projects | where: "slug", page.parent | first %}
{% if page.video and page.video != "" %}
<div class="row mb-3"><div class="col-sm">
{% include video.liquid path=page.video class="img-fluid rounded z-depth-1" %}
</div></div>
{% elsif page.preview %}
{% assign src = page.preview %}{% unless src contains '://' %}{% assign src = src | relative_url %}{% endunless %}
<img src="{{ src }}" alt="{{ page.title }}" class="img-fluid rounded z-depth-1" style="width:100%;margin-bottom:1rem">
{% endif %}

<p style="font-style:italic">{% if page.parent %}Part of {% if parent %}<a href="{{ parent.url | relative_url }}">{{ parent.title }}</a>{% else %}{{ page.event_title }}{% endif %}{% if page.event_info %}, {{ page.event_info }}{% endif %}{% else %}{{ page.event_info }}{% endif %}</p>

{% if page.subtitle and page.subtitle != page.title %}<h2>{{ page.subtitle }}</h2>{% endif %}

<h3>Description</h3>
{{ page.long_description | markdownify }}

{% if page.speakers %}
<h3>Speakers</h3>
<ul>
{% for s in page.speakers %}<li><strong>{{ s.name }}</strong>{% if s.affiliation %}, {{ s.affiliation }}{% endif %}</li>
{% endfor %}</ul>
{% endif %}
{% if page.moderators %}
<h3>Moderation</h3>
<ul>
{% for s in page.moderators %}<li><strong>{{ s.name }}</strong>{% if s.affiliation %}, {{ s.affiliation }}{% endif %}</li>
{% endfor %}</ul>
{% endif %}

{% if page.original_url %}
<p>More on the <a href="{{ page.original_url }}" target="_blank">event page of the d\carb future economy forum</a>.</p>
{% endif %}
